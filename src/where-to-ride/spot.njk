---
pagination:
  data: spots
  size: 1
  alias: spot
  addAllPagesToCollections: true
permalink: "/where-to-ride/{{ spot.id }}/"
layout: layouts/article-page.njk
eleventyComputed:
  title: "{{ spot.name }}"
  eyebrow: "Where to Ride"
  description: "{{ spot.city }}, {{ spot.state }} — {{ spot.description | excerpt(150) }}"
extraCss:
  - /assets/vendor/leaflet/leaflet.css
  - /assets/css/where-to-ride.css
  - /assets/css/conditions-badge.css
extraJs:
  - /assets/vendor/leaflet/leaflet.js
  - /assets/js/windy-embed.js
  - /assets/js/conditions-badge.js
  - /assets/js/spot-page.js
  - /assets/js/spot-feedback.js
---
<nav class="breadcrumb"><a href="{{ '/where-to-ride/' | url }}">Where to Ride</a> <span>/</span> <span>{{ spot.name }}</span></nav>

<div class="spot-popup-badges spot-page-badges">
  {%- if spot.verified == "firsthand-verified" %}
  <span class="spot-badge spot-badge--verified">Firsthand verified</span>
  {%- else %}
  <span class="spot-badge spot-badge--community">Community-reported</span>
  {%- endif %}
  {%- if spot.localsMeetHere %}
  <span class="spot-badge spot-badge--locals">Locals meet here</span>
  {%- endif %}
</div>

<p class="spot-page-location">{{ spot.city }}, {{ spot.state }} &mdash; {{ spot.region }}</p>

<p class="spot-page-desc">{{ spot.description | linkify | safe }}</p>

{% if spot.sourceNote %}<p class="spot-popup-source">{{ spot.sourceNote }}</p>{% endif %}

<h2>Key Facts</h2>
<dl class="spot-page-facts">
  <dt>Water type</dt><dd>{{ spot.waterType }}</dd>
  <dt>Best wind direction</dt><dd>{{ spot.windDirection }}</dd>
  <dt>Skill level</dt><dd>{{ spot.skillLevel }}</dd>
</dl>

<h2>Live Wind Here</h2>
<div class="spot-page-wind">
  <div class="spot-page-wind-frame">
    <iframe id="spotWindFrame" title="Live wind map for {{ spot.name }}" loading="lazy" frameborder="0"></iframe>
  </div>
  <p class="spot-popup-wind-attribution">Powered by <a href="https://www.windy.com" target="_blank" rel="noopener">Windy.com</a></p>
  <div class="conditions-badge-block" id="spotConditionsBadge"
    data-lat="{{ spot.lat }}" data-lng="{{ spot.lng }}"
    data-ideal-directions="{{ spot.idealWindDirections | join(',') if spot.idealWindDirections else '' }}" hidden></div>
</div>

<h2>Satellite View</h2>
<div id="spotMap" class="spot-page-map" data-lat="{{ spot.lat }}" data-lng="{{ spot.lng }}" data-name="{{ spot.name }}"></div>

<p><a href="{{ '/where-to-ride/' | url }}">&larr; Back to the full map</a></p>

<p class="spot-feedback-link">
  <a href="#" id="spotFeedbackOpen"
    data-spot-id="{{ spot.id }}" data-spot-name="{{ spot.name }}"
    data-spot-lat="{{ spot.lat }}" data-spot-lng="{{ spot.lng }}">See something wrong, or ride here yourself? Let us know</a>
</p>

<div class="submit-spot-modal" id="spotFeedbackModal" hidden>
  <div class="submit-spot-modal-backdrop" data-modal-close></div>
  <div class="submit-spot-modal-dialog" role="dialog" aria-modal="true" aria-labelledby="spotFeedbackModalTitle">
    <div class="submit-spot-modal-header">
      <div>
        <p class="eyebrow submit-spot-modal-eyebrow">{{ spot.name }}</p>
        <h2 id="spotFeedbackModalTitle" class="submit-spot-modal-title">Help Improve This Spot</h2>
      </div>
      <button type="button" class="submit-spot-modal-close" data-modal-close aria-label="Close">&times;</button>
    </div>

    <div id="spotFeedbackChoice" class="spot-feedback-choice">
      <button type="button" class="btn btn-outline spot-feedback-choice-btn" data-feedback-type="correction">Suggest a correction</button>
      <button type="button" class="btn btn-outline spot-feedback-choice-btn" data-feedback-type="confirmation">I ride/teach here &mdash; confirm this spot</button>
    </div>

    <form id="spotFeedbackForm" class="spot-feedback-form" hidden>
      <p class="spot-feedback-form-intro" id="spotFeedbackFormIntro"></p>
      <label for="spotFeedbackMessage">What should we know?</label>
      <textarea id="spotFeedbackMessage" rows="4" required></textarea>
      <label for="spotFeedbackEmail">Email (optional, in case we have questions)</label>
      <input type="email" id="spotFeedbackEmail">
      <div id="spotFeedbackMapWrap" class="spot-feedback-map-wrap" hidden>
        <p class="spot-feedback-map-label">Drag the pin to the exact launch spot</p>
        <div id="spotFeedbackMap" class="spot-feedback-map"></div>
      </div>
      <button type="submit" class="btn btn-accent">Continue to Submit</button>
    </form>

    <div id="spotFeedbackAirtableWrap" hidden>
      <iframe id="spotFeedbackIframe" class="airtable-embed" title="Submit spot feedback" frameborder="0" width="100%" height="533" style="background: transparent;"></iframe>
    </div>
  </div>
</div>
