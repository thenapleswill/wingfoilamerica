<header class="site-header">
  <div class="wrap site-header-inner">
    <a class="brand" href="{{ '/' | url }}">
      <span class="brand-mark">WFA</span>
      <span class="brand-name">Wing Foil America</span>
    </a>
    <button class="nav-toggle" id="navToggle" aria-label="Toggle menu" aria-expanded="false" aria-controls="siteNav">
      <span></span><span></span><span></span>
    </button>
    <nav class="site-nav" id="siteNav">
      <ul>
        {% for item in site.nav %}
        <li>
          <a href="{{ item.url | url }}" class="{% if page.url.startsWith(item.url) %}is-active{% endif %}">{{ item.title }}</a>
        </li>
        {% endfor %}
      </ul>
      <div class="nav-search" id="navSearch"></div>
    </nav>
  </div>
</header>
