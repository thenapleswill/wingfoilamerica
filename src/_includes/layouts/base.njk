<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{% if title %}{{ title }} — {{ site.name }}{% else %}{{ site.name }} — {{ site.tagline }}{% endif %}</title>
<meta name="description" content="{{ description or site.tagline }}">
{% if site.plausibleDomain != "REPLACE_WITH_YOUR_PLAUSIBLE_DOMAIN" %}
<script defer data-domain="{{ site.plausibleDomain }}" src="https://plausible.io/js/script.js"></script>
{% endif %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="{{ '/pagefind/pagefind-ui.css' | url }}">
<link rel="stylesheet" href="{{ '/assets/css/styles.css' | url }}">
{% for href in extraCss %}
<link rel="stylesheet" href="{{ href | url }}">
{% endfor %}
</head>
<body>
{% include "partials/nav.njk" %}
<main>
{{ content | safe }}
</main>
{% include "partials/footer.njk" %}
<script src="{{ '/pagefind/pagefind-ui.js' | url }}"></script>
<script src="{{ '/assets/js/main.js' | url }}"></script>
<script src="{{ '/assets/js/search-init.js' | url }}"></script>
{% for src in extraJs %}
<script src="{{ src | url }}"></script>
{% endfor %}
</body>
</html>
